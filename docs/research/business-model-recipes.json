    {
      "id": "51-investment-commission-per-deal",
      "title": "Find investment companies whose revenue model is commission per deal",
      "status": "captured_live_gateway",
      "company_search_executed": true,
      "requests": [
        {
          "key": "51-investment-commission-per-deal-lookup",
          "label": "Discover the relevant vocabulary",
          "operation": "company_filter_options",
          "path": "/v1/companies/filter-options",
          "request": {
            "field": "revenue_models",
            "q": "commission",
            "limit": 10
          }
        },
        {
          "key": "51-investment-commission-per-deal-search",
          "label": "Search the candidate cohort",
          "operation": "search_companies",
          "path": "/v1/companies/search",
          "request": {
            "filters": {
              "industries": [
                "Investment Management & Fund Operators"
              ],
              "revenue_models": [
                "commission on transaction"
              ]
            },
            "match_mode": "strict",
            "page": 0,
            "limit": 20
          }
        },
        {
          "key": "51-investment-commission-per-deal-variant-1",
          "label": "Limit recorded company location to the United States",
          "operation": "search_companies",
          "path": "/v1/companies/search",
          "request": {
            "filters": {
              "industries": [
                "Investment Management & Fund Operators"
              ],
              "revenue_models": [
                "commission on transaction"
              ],
              "locations": [
                "United States"
              ]
            },
            "match_mode": "strict",
            "page": 0,
            "limit": 20
          }
        },
        {
          "key": "51-investment-commission-per-deal-variant-2",
          "label": "Explore broker and deal-adviser wording across industries",
          "operation": "semantic_company_search",
          "path": "/v1/companies/semantic-search",
          "request": {
            "q": "investment brokers and advisers arranging investment deals and charging a commission per completed deal",
            "filters": {
              "revenue_models": [
                "commission on transaction"
              ]
            },
            "match_mode": "strict",
            "page": 0,
            "limit": 20
          }
        },
        {
          "key": "51-investment-commission-per-deal-variant-3",
          "label": "Investor-classified entities with a commission tag",
          "operation": "search_investors",
          "path": "/v1/investors/search",
          "request": {
            "filters": {
              "revenue_models": [
                "commission on transaction"
              ]
            },
            "match_mode": "expanded",
            "page": 0,
            "limit": 20
          }
        },
        {
          "key": "51-investment-commission-per-deal-columns",
          "label": "Add listing columns to reviewed domains",
          "operation": "get_company_columns",
          "path": "/v1/companies/columns",
          "request": {
            "domains": [
              "candidate.example"
            ],
            "columns": [
              "industry",
              "business_model",
              "revenue_model",
              "country",
              "latest_revenue"
            ]
          }
        },
        {
          "key": "51-investment-commission-per-deal-profile",
          "label": "Discover available company detail fields",
          "operation": "get_company",
          "path": "/v1/companies/profile",
          "request": {
            "domain": "candidate.example"
          }
        },
        {
          "key": "51-investment-commission-per-deal-classification",
          "label": "Read company classifications separately",
          "operation": "get_company_field",
          "path": "/v1/companies/field",
          "request": {
            "domain": "candidate.example",
            "field": "classification",
            "item_limit": 100
          }
        }
      ],
      "captures": [
        "docs/examples/business-models/51-investment-commission-per-deal-search.json"
      ]
    },
