# Private preview. No external service is launched by installing this package.
RADAR_UPSTREAM_URL=http://127.0.0.1:5100
# Optional, separately operated Prism services; leave blank if unavailable.
RADAR_NEWS_URL=
RADAR_BUSINESS_NEWS_URL=
# Owner-only JSON file generated by radar-create-key; never commit it.
RADAR_KEYS_FILE=secrets/keys.json
# Optional operator-only connection for deep company profiles. Use a read-only
# credential for companies_data.main_data, company_pubmap and company_enrichment.
# Never accept this URI from API callers or commit its value.
RADAR_PROFILE_MONGO_URI=
RADAR_TIMEOUT_SECONDS=45
RADAR_MAX_RESPONSE_BYTES=8388608
# HTTP binds to loopback by default. Configure exact hosts/origins before a private proxy.
RADAR_ALLOWED_HOSTS=127.0.0.1,localhost,::1
RADAR_ALLOWED_ORIGINS=
# Used only by the stdio MCP client process:
RADAR_API_KEY=
# Optional private account mode. Replaces JSON preview-key authentication entirely.
RADAR_ACCOUNTS_ENABLED=0
RADAR_ACCOUNTS_DB=secrets/accounts.sqlite3
# Multi-host ledger: a postgresql:// URL replaces RADAR_ACCOUNTS_DB. Needs the postgres extra.
RADAR_ACCOUNTS_DATABASE_URL=
# Exact proxy addresses/CIDRs whose X-Forwarded-For is believed. Blank trusts none.
RADAR_TRUSTED_PROXIES=
# New API accounts admitted per client address per day, and in total per hour.
RADAR_NEW_ACCOUNTS_PER_IP_DAY=3
RADAR_NEW_ACCOUNTS_PER_HOUR=100
# Persistent Fernet key from the operator's secret manager; never commit it.
RADAR_ENCRYPTION_KEY=
# Private policy default: verified Free/Pro users may buy credits without a data-plan upgrade.
RADAR_PAYG_ALL_PLANS=1
# Integer minor units per credit. Checkout needs the USD rate, which also sets the
# minimum top-up; INR is optional. Zero means that currency is not offered.
RADAR_CREDIT_PRICE_CENTS=0
RADAR_CREDIT_PRICE_PAISE=0
# Smallest top-up in US cents, applied as a credit count in every currency.
RADAR_MIN_TOPUP_CENTS=500
RADAR_RAZORPAY_KEY_ID=
RADAR_RAZORPAY_KEY_SECRET=
RADAR_RAZORPAY_WEBHOOK_SECRET=

# Optional reviewed immutable Atlas release with meta/ and data/ directories.
# Each investor request still checks Radar publication status and the stored hash.
RADAR_INVESTOR_DATA_DIR=

# Optional operator-only read connections for individual Play Store apps and
# dedicated internships. Use read-only grants; clients cannot supply databases.
RADAR_JOBS_MONGO_URI=
RADAR_APPS_CH_URL=
RADAR_APPS_CH_USER=
RADAR_APPS_CH_PASSWORD=

# Optional operator-only read connection for company LinkedIn observations.
# Use read-only grants for linkedin_profile_logs and social_media_posts.
# Leave these blank in shared files; supply credentials through private runtime configuration.
RADAR_SOCIAL_CH_URL=
RADAR_SOCIAL_CH_USER=
RADAR_SOCIAL_CH_PASSWORD=

# Optional read-only company traffic and customer-review observations.
# Grant only semrush_website, trustpilot_reviews and trustpilot_review_samples.
RADAR_COMPANY_CH_URL=
RADAR_COMPANY_CH_USER=
RADAR_COMPANY_CH_PASSWORD=
